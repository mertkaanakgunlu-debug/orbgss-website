      "center_lat_deg": "required. Footprint centre latitude, degrees north.",
      "center_lon_deg": "required. Footprint centre longitude, degrees east.",
      "span_km": "required. Edge length of the square footprint, kilometres of surface arc.",
      "bearing_deg": "optional, default 0. Rotation of the footprint about its own surface normal.",
      "surface_offset_m": "optional, default 250. Anti-z-fighting offset above the Earth radius; visual only.",
      "edge_samples": "optional, default 48. Slerp samples per footprint edge; controls how finely the border follows curvature.",
      "fill_grid": "optional, default 24. Interior grid resolution per axis; also the AOI-local (u, v) sweep parameter space.",
      "border_width_km": "optional, default 14. Width of the border ribbon, kilometres of surface arc.",
      "corner_lock_arm_km": "optional, default 70. Length of each corner-lock arm along the adjacent edge.",
      "corner_lock_width_km": "optional, default 9. Width of the corner-lock arm ribbon.",
      "corner_lock_offset_m": "optional, default 400. Extra radial offset for corner locks so they read above the border."
    },
