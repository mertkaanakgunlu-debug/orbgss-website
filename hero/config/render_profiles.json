{
  "schema_version": 1,
  "phase": "WEB-005",
  "aspect_ratio": {
    "width": 16,
    "height": 9
  },
  "device_preference": [
    "OPTIX",
    "CUDA",
    "HIP",
    "ONEAPI",
    "METAL"
  ],
  "allow_cpu_fallback": true,
  "engine_aliases": {
    "EEVEE": [
      "BLENDER_EEVEE_NEXT",
      "BLENDER_EEVEE"
    ],
    "CYCLES": [
      "CYCLES"
    ]
  },
  "profiles": {
    "preview": {
      "role": "fast_iteration",
      "engine": "EEVEE",
      "resolution_x": 1280,
      "resolution_y": 720,
      "resolution_percentage": 100,
      "samples": 32,
      "denoise": false,
      "file_format": "PNG",
      "color_depth": "8",
      "compression": 20,
      "prefer_gpu": true,
      "publish_evidence": false
    },
    "master": {
      "role": "high_quality",
      "engine": "CYCLES",
      "resolution_x": 1920,
      "resolution_y": 1080,
      "resolution_percentage": 100,
      "samples": 256,
      "adaptive_threshold": 0.01,
      "max_bounces": 8,
      "denoise": true,
      "denoiser_preference": [
        "OPTIX",
        "OPENIMAGEDENOISE"
      ],
      "file_format": "PNG",
      "color_depth": "16",
      "compression": 15,
      "prefer_gpu": true,
      "publish_evidence": false
    },
    "evidence_still": {
      "role": "bounded_evidence",
      "engine": "CYCLES",
      "resolution_x": 1280,
      "resolution_y": 720,
      "resolution_percentage": 100,
      "samples": 256,
      "adaptive_threshold": 0.01,
      "max_bounces": 8,
      "denoise": true,
      "denoiser_preference": [
        "OPTIX",
        "OPENIMAGEDENOISE"
      ],
      "file_format": "PNG",
      "color_depth": "8",
      "compression": 25,
      "prefer_gpu": true,
      "publish_evidence": true,
      "note": "Same Cycles path as the master profile at reviewable size and 8-bit depth, so a review still can be committed without putting a large binary in source control. Masters stay 16-bit and out of Git."
    },
    "production": {
      "role": "production_media",
      "engine": "CYCLES",
      "resolution_x": 2304,
      "resolution_y": 1296,
      "resolution_percentage": 100,
      "samples": 128,
      "adaptive_threshold": 0.01,
      "max_bounces": 8,
      "denoise": true,
      "denoiser_preference": [
        "OPTIX",
        "OPENIMAGEDENOISE"
      ],
      "file_format": "PNG",
      "color_depth": "8",
      "compression": 15,
      "prefer_gpu": true,
      "publish_evidence": false,
      "note": "WEB-005A production hero frames. Rendered at 2304 x 1296 and delivered at 1920 x 1080 or below: supersampling removes the edge aliasing and sampling noise the accepted build fed straight into a bitrate-starved encoder, and a cleaner source both looks sharper and compresses better. 128 adaptive samples is not a reduction in quality per delivered pixel -- the 1.44x downscale averages that many samples back up. Frames are intermediate and stay out of Git."
    }
  },
  "default_preview_profile": "preview",
  "default_still_profile": "master",
  "benchmark_profiles": [
    "preview",
    "master",
    "evidence_still"
  ],
  "production_profile": "production"
}
